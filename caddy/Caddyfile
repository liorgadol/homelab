# Local names for every web UI in the stack. Pi-hole answers *.gadol.lan with
# the host IP (FTLCONF_misc_dnsmasq_lines in docker-compose.yml), so each name
# lands here and is forwarded to the service's published port.
#
# Plain HTTP: no public CA issues certificates for .lan. The http:// prefix
# turns off Caddy's automatic HTTPS for that site.
#
# After editing: docker compose restart caddy

# Bare IP: health check for Uptime Kuma (kuma.caddy-web label)
http://192.168.1.200 {
	respond "OK"
}

http://home.gadol.lan {
	# Homepage rejects Host headers missing from HOMEPAGE_ALLOWED_HOSTS.
	# Send the IP:port it already accepts instead of home.gadol.lan.
	reverse_proxy 192.168.1.200:3000 {
		header_up Host {upstream_hostport}
	}
}

http://dozzle.gadol.lan {
	reverse_proxy 192.168.1.200:8080
}

http://files.gadol.lan {
	reverse_proxy 192.168.1.200:8081
}

http://pihole.gadol.lan {
	redir / /admin/
	reverse_proxy 192.168.1.200:8053
}

http://pinchflat.gadol.lan {
	reverse_proxy 192.168.1.200:8945
}

http://dockhand.gadol.lan {
	reverse_proxy 192.168.1.200:3001
}

http://pdf.gadol.lan {
	reverse_proxy 192.168.1.200:8090
}

http://wud.gadol.lan {
	reverse_proxy 192.168.1.200:3033
}

http://wg.gadol.lan {
	reverse_proxy 192.168.1.200:51821
}

http://glances.gadol.lan {
	reverse_proxy 192.168.1.200:61208
}

http://go2rtc.gadol.lan {
	reverse_proxy 192.168.1.200:1984
}

http://cams.gadol.lan {
	reverse_proxy 192.168.1.200:8082
}

http://cutter.gadol.lan {
	reverse_proxy 192.168.1.200:8083
}

http://emby.gadol.lan {
	reverse_proxy 192.168.1.200:8096
}

http://kuma.gadol.lan {
	reverse_proxy 192.168.1.200:3002
}

# Network gear outside Docker. Router admin pages often reject a Host
# header that is not their own IP, so send the IP instead.
http://router.gadol.lan {
	reverse_proxy 192.168.1.1:80 {
		header_up Host {upstream_hostport}
	}
}

http://ap.gadol.lan {
	reverse_proxy 192.168.1.150:80 {
		header_up Host {upstream_hostport}
	}
}

# qBittorrent on the Windows Server. Its CSRF check rejects requests whose Origin or
# Referer differs from the Host it sees, so send its own address and drop both.
http://torrent.gadol.lan {
	reverse_proxy 192.168.1.2:8090 {
		header_up Host {upstream_hostport}
		header_up -Origin
		header_up -Referer
	}
}

# Immich, behind its own nginx on 2284 (TLS with a ZeroSSL cert for
# liorgadol.ddnsfree.com). Redirect, not proxy: nginx rate-limits by source
# IP and exempts only 192.168.0.0/16, while proxied requests arrive from
# Caddy's Docker address, so a page load of ~100 assets got HTTP 429.
# Still HTTPS: Immich's HSTS header reached browsers through the old proxy,
# so they refuse http://immich.gadol.lan for a year. tls internal signs it
# with Caddy's local CA, whose root certificate each device must trust
# (caddy/data/caddy/pki/authorities/local/root.crt).
https://immich.gadol.lan {
	tls internal
	redir https://liorgadol.ddnsfree.com:2284{uri}
}

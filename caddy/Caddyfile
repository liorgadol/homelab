# Local names for every web UI in the stack. Pi-hole answers *.gadol.lan with
# the host IP (FTLCONF_misc_dnsmasq_lines in docker-compose.yml), so each name
# lands here and is forwarded to the service's published port.
#
# Plain HTTP: no public CA issues certificates for .lan. The http:// prefix
# turns off Caddy's automatic HTTPS for that site.
#
# After editing: docker compose restart caddy
#
# Every site except the bare-IP health check starts with import access_log,
# so caddy/ui can show its requests. Add it to new sites too.

{
	# Admin API on every interface of the container so caddy/ui and Homarr
	# can reach caddy:2019. The default (localhost) is unreachable from other
	# containers. Not published on the host; see docker-compose.yml.
	admin 0.0.0.0:2019
}

# Request log for caddy/ui (Access Logs > Caddy reads CADDY_LOG_PATH, default
# /var/log/caddy/access.log). Mounted to caddy/logs; rolls at 10MiB, keeps 5.
# Kept short: request and response headers are dropped, and static assets,
# event streams and websockets (UIs polling or holding a connection open)
# are not logged at all.
(access_log) {
	@log_noise {
		path *.js *.mjs *.css *.map *.png *.jpg *.jpeg *.gif *.svg *.ico *.webp *.woff *.woff2 *.ttf
	}
	@log_stream header Accept *text/event-stream*
	@log_websocket header Connection *Upgrade*
	log_skip @log_noise
	log_skip @log_stream
	log_skip @log_websocket
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format filter {
			wrap json
			request>headers delete
			resp_headers delete
		}
	}
}

# Bare IP: health check for Uptime Kuma (kuma.caddy-web label)
http://192.168.1.200 {
	respond "OK"
}

http://home.gadol.lan {
	import access_log
	# Homarr dashboard. Upstream sees IP:port as Host, same as direct access.
	reverse_proxy 192.168.1.200:7575 {
		header_up Host {upstream_hostport}
	}
}

